<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JassCardEye.Dataset.Viewer.AboutWindow"
        Title="About JassCardEye Dataset Tool"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#141414"
        Icon="/Assets/AppIcon.png">
    <StackPanel Margin="28,26,28,22" Spacing="6" HorizontalAlignment="Center">
        <Image Source="/Assets/AppIcon-macOS.png" Width="112" Height="112" HorizontalAlignment="Center"/>
        <TextBlock Text="JassCardEye Dataset Tool" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
        <TextBlock Name="VersionText" Classes="subtitle" HorizontalAlignment="Center"/>
        <TextBlock Classes="subtitle" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                   Text="Browses and corrects the datasets, labels real photos of Jass cards and turns videos into frames to label – the desktop side of JassCardEye, the app that counts Jass cards with the phone camera."/>
        <TextBlock Text="YARX GmbH" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        <HyperlinkButton Content="yarx.ch" NavigateUri="https://yarx.ch" HorizontalAlignment="Center"
                         Background="Transparent" Foreground="#8cc4ff" Padding="4,0"/>
        <Button Content="Close" Click="OnClose" HorizontalAlignment="Center" MinWidth="90"
                HorizontalContentAlignment="Center" Margin="0,14,0,0"/>
    </StackPanel>
</Window>
