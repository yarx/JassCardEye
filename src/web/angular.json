{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "jasscardeye-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": { "code": "de", "subPath": "de" },
        "locales": {
          "fr": { "translation": "src/locale/messages.fr.json" },
          "it": { "translation": "src/locale/messages.it.json" },
          "en": { "translation": "src/locale/messages.en.json" }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "polyfills": ["@angular/localize/init"],
            "i18nMissingTranslation": "error"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all",
              "localize": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "fr": { "localize": ["fr"] },
            "it": { "localize": ["it"] },
            "en": { "localize": ["en"] }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "jasscardeye-web:build:production"
            },
            "development": {
              "buildTarget": "jasscardeye-web:build:development"
            },
            "fr": { "buildTarget": "jasscardeye-web:build:development,fr" },
            "it": { "buildTarget": "jasscardeye-web:build:development,it" },
            "en": { "buildTarget": "jasscardeye-web:build:development,en" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
